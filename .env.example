# Wisuno Studio — Environment Configuration
# Copy this file to .env and fill in your values.
# IMPORTANT: Local development must point to wisuno-studio-dev, never production.

# Environment: "local" or "production"
# Railway must set ENV=production (startup fails closed if Supabase vars are missing).
ENV=local

# Local Auth Bypass (effective ONLY when ENV=local)
# Set DEV_AUTH_BYPASS=1 to use the local dev user without requiring a Supabase session.
# By default, the dev user has role "dev". Set DEV_AUTH_ADMIN=1 to grant the "admin" role.
DEV_AUTH_BYPASS=0
DEV_AUTH_ADMIN=0

# Supabase (Auth, Database, Storage)
# In local development, use your wisuno-studio-dev project credentials.
SUPABASE_URL=https://your-dev-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Required: Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Required for meme image generation: Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Optional: Higgsfield API — text-to-image via FLUX/Seedream (https://cloud.higgsfield.ai)
# Use --higgsfield flag to activate; format can be "key-id:key-secret" or just an API key
HIGGSFIELD_API_KEY=your-higgsfield-api-key

# Required for slide image search: Google Custom Search API
# 1. Create a Search Engine at https://programmablesearchengine.google.com
#    (enable "Search entire web" + "Image search", copy the cx ID)
# 2. Enable Custom Search API at https://console.cloud.google.com and create a key
GOOGLE_CSE_API_KEY=your-google-api-key
GOOGLE_CSE_ID=your-google-cse-id
